<?xml version="1.0" encoding="UTF-8"?>
<!--
  A deliberately invented, minimal schema used by testCalendar.  It exercises
  calendar-schema loading without reproducing CEWE's supplied definitions.
-->
<calendar_schemas>
  <!-- Invented local stand-ins for named CEWE themes used by calendar tests. -->
  <calendararea schema="cewe2pdf-test-transparent-white" gridcolor="transparent">
    <cell type="CALENDAR_CELL_TYPE_YEAR" textcolor="#ffffff" bgcolor="transparent"/>
    <cell type="CALENDAR_CELL_TYPE_MONTH" textcolor="#ffffff" bgcolor="transparent"/>
  </calendararea>
  <calendararea schema="cewe2pdf-test-black-white" gridcolor="#000000">
    <cell type="CALENDAR_CELL_TYPE_HEAD_WEEKDAY" textcolor="#000000" bgcolor="#ffffff"/>
    <cell type="CALENDAR_CELL_TYPE_WEEKDAY" textcolor="#000000" bgcolor="#ffffff"/>
    <cell type="CALENDAR_CELL_TYPE_SATURDAY" textcolor="#000000" bgcolor="#ffffff"/>
    <cell type="CALENDAR_CELL_TYPE_SUNDAY" textcolor="#000000" bgcolor="#ffffff"/>
    <cell type="CALENDAR_CELL_TYPE_HOLIDAY" textcolor="#000000" bgcolor="#ffffff"/>
    <cell type="CALENDAR_CELL_TYPE_WEEK_OF_YEAR" textcolor="#000000" bgcolor="#ffffff"/>
  </calendararea>
  <calendararea schema="cewe2pdf-test-yellow-weekends">
    <cell type="CALENDAR_CELL_TYPE_HEAD_WEEKDAY" textcolor="#102030" bgcolor="#f2f2d0"/>
    <cell type="CALENDAR_CELL_TYPE_WEEKDAY" textcolor="#102030" bgcolor="#ffffe8"/>
    <cell type="CALENDAR_CELL_TYPE_HEAD_SATURDAY" textcolor="#602000" bgcolor="#ffc85a"/>
    <cell type="CALENDAR_CELL_TYPE_SATURDAY" textcolor="#602000" bgcolor="#ffe0a0"/>
    <cell type="CALENDAR_CELL_TYPE_HEAD_SUNDAY" textcolor="#8a1020" bgcolor="#ff9a70"/>
    <cell type="CALENDAR_CELL_TYPE_SUNDAY" textcolor="#8a1020" bgcolor="#ffd0bc"/>
  </calendararea>
</calendar_schemas>
